'You provide a source directory with either 2,3, or 4 wavelengths where
'the file must end with w1, w2, w3, or w4 for blue, green, red, and gray respectively
'This allows you to set contrast based on one image and applies to the rest
'Also merges together different combinations of wavelengths and saves to a set 
'destination directory

dir1 = getDirectory("Choose Source Directory ");
dir2 = getDirectory("Choose_ Destination Directory ");
list = getFileList(dir1);
Dialog.create("Method");
  Dialog.addChoice("File Extension:", newArray(".tif", ".TIF"));
  Dialog.addChoice("Adjustment Method:", newArray("Manual", "Automatic"));
  Dialog.addChoice("Wavelengths:", newArray("4 Wavelengths", "3 Wavelengths", "2 Wavelengths"));
  Dialog.show();
  type = Dialog.getChoice();
  method = Dialog.getChoice();
  wl = Dialog.getChoice();

if (wl=="2 Wavelengths"){wl2();}
if (wl=="3 Wavelengths"){wl3();}
if (wl=="4 Wavelengths"){wl4();}

function wl2(){
	if (method=="Automatic"){automatic2();}
	if (method=="Manual"){manual2();}
}

function wl3(){
	if (method=="Automatic"){automatic3();}
	if (method=="Manual"){manual3();}
}

function wl4(){
	if (method=="Automatic"){automatic4();}
	if (method=="Manual"){manual4();}
}

function manual2(){
	setBatchMode("show");
for (i=0; i<2; i++) {
    showProgress(i+1, list.length);
filename = dir1 + list[i];
    if (endsWith(filename, "w1"+type)) {
open(filename);
rename("blue");
}
	if (endsWith(filename, "w2"+type)) {
open(filename);
rename("green");
}
	if (nImages>1) {
      run("Merge Channels...", "c2=[green] c3=[blue] create");
      run("Make Composite");
      Stack.setDisplayMode("color");
	}
	run("Brightness/Contrast...");
}
waitForUser("Continue?");
   Stack.setChannel(1);
      getMinAndMax(min1, max1);
      Stack.setChannel(2);
      getMinAndMax(min2, max2);
close();
setBatchMode("show");

for (i=0; i<list.length; i++) {
    showProgress(i+1, list.length);
filename = dir1 + list[i];
    if (endsWith(filename, "w1"+type)) {
open(filename);
rename("blue");
}
	if (endsWith(filename, "w2"+type)) {
open(filename);
rename("green");
}
	if (nImages>1) {
	  selectWindow("green");
	  setMinAndMax(min1, max1);
	  selectWindow("blue");
	  setMinAndMax(min2, max2);
      run("Merge Channels...", "c2=[green] c3=[blue] create");
      'Begin Vickys code
      run("Set Scale...", "distance=1 known=0.649 unit=um");
      run("Scale Bar...", "width=200 height=12 font=42 color=White background=None location=[Lower Right] bold overlay");
      run("Make Composite");
      Stack.setActiveChannels("10");
      saveAs("jpeg", dir2+list[i] + "_GREEN");
      Stack.setActiveChannels("01");
      saveAs("jpeg", dir2+list[i]+"_BLUE"); 
      Stack.setActiveChannels("11");
      saveAs("jpeg", dir2+list[i]+"_MERGED");
      close();
      }
}
}

