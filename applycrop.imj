'Applies the "sections to crop" listed in the ROI manager to every open image. Make sure all images are the same size!

// ===== USER SETTINGS =====
outputDir = "//outputdirectory/path/";

// Create output directory if needed
File.makeDirectory(outputDir);

// Get list of open images
titles = getList("image.titles");

// Get number of ROIs
roiCount = roiManager("count");
if (roiCount == 0) {
    exit("No ROIs found in the ROI Manager.");
}

// Loop over all open images
for (i = 0; i < titles.length; i++) {

    selectWindow(titles[i]);
    baseName = replace(titles[i], ".tif", "");

    // Apply each ROI
    for (r = 0; r < roiCount; r++) {

        roiManager("Select", r);

        // Duplicate only the ROI region
        run("Duplicate...", "title=" + baseName + "_ROI" + (r+1));

        // Save cropped ROI
        saveAs("Tiff", outputDir + baseName + "_ROI" + (r+1) + ".tif");

        // Close cropped image
        close();
    }
}

print("ROI cropping and saving complete.");
